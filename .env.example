# Copy to .env (git-ignored) and fill in. Sandbox keys: developer.paypal.com > Apps & Credentials > Sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# console.anthropic.com > API keys
ANTHROPIC_API_KEY=
FLORIST_MODEL=claude-haiku-5-5
# No Anthropic key? Use the free Gemini florist (a Cloudflare Worker) instead: uncomment the next line.
# VITE_FLORIST_URL=https://bouquet-florist.bouquet-designer.workers.dev
# Most calls the florist makes to Claude per day, across all customers.
FLORIST_DAILY_CALLS=2000
# Optional gift extras in the florist chat: trychannel3.com/developers. The Worker needs its own copy as a secret.
CHANNEL3_API_KEY=
# A random string of at least 16 characters; the florist board asks for it (a shorter key leaves the board closed).
FLORIST_KEY=
PORT=8787
# Set to 1 when the server sits behind a reverse proxy such as Render, so each customer gets their own rate limit.
# TRUST_PROXY=1
