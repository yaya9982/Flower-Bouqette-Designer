# Copy to .env (git-ignored) and fill in. Sandbox keys: developer.paypal.com > Apps & Credentials > Sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# console.anthropic.com > API keys
ANTHROPIC_API_KEY=
FLORIST_MODEL=claude-haiku-5-5
# Most calls the florist makes to Claude per day, across all customers.
FLORIST_DAILY_CALLS=2000
# Any long random string; the florist board asks for it.
FLORIST_KEY=
PORT=8787
